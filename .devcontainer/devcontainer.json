// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "C++ ONNXRuntime and TensorRT Dev Container",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "."
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace/lightly-train,type=bind,consistency=cached",
	"workspaceFolder": "/workspace/lightly-train",
	"containerEnv": {
		"UV_NO_SYNC": "1",
		"UV_PROJECT_ENVIRONMENT": "/opt/venv"
	},
	// Requires the NVIDIA Container Toolkit on the host.
	"runArgs": ["--gpus=all"],
	"hostRequirements": {
		"gpu": "optional"
	},
	// Installs lightly-train (for exporting models) plus the pinned CUDA torch
	// build, then configures+builds the examples/cpp recipes to verify the
	// OpenCV/CUDA/ONNX Runtime/TensorRT toolchain resolves correctly.
	"postCreateCommand": "git config --global --add safe.directory /workspace/lightly-train && uv sync --python /usr/bin/python3 --frozen --group dev --group pinned-torch-maximal --extra onnx --extra onnxruntime --extra onnxslim && uv pip install --python /opt/venv/bin/python 'tensorrt-cu12==10.13.3.9' && /opt/venv/bin/python -c \"import lightly_train, onnx, onnxruntime, tensorrt\" && cmake -S examples/cpp -B examples/cpp/build && cmake --build examples/cpp/build -j"
}
